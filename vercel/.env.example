# Klucz podpisu webhooka (ustawiony w https://ssl.vpbx.pl/apiaccounts/settings)
VPBX_SIGNING_KEY=

# Dane konta API (https://ssl.vpbx.pl/apiaccounts/view)
VPBX_API_USERNAME=
VPBX_API_PASSWORD=

# Numer w formacie E.164, na ktory zostanie wyslany SMS z powiadomieniem
NOTIFY_NUMBER=48500000000

# Nadawca SMS (alfanumeryczny lub numer)
SMS_SENDER=callapi.pl

# Pomijanie weryfikacji podpisu. Ustaw na 1, jezeli VPBX
# nie wysyla jeszcze podpisanych webhookow. W produkcji pozostaw puste.
SKIP_SIGNATURE=1
